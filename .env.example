# ---------------------------------------------------------------------------
# AskDock environment
# Copy to .env.local and fill in. Leave the Supabase keys empty to run the
# in-memory demo workspace (seeded Juniper Dental bot, no accounts needed).
# Never commit real keys.
# ---------------------------------------------------------------------------

# Public URL of this app (used for auth redirects, Stripe return URLs and the embed snippet)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for widget traffic, ingestion and Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — embeddings (pgvector) and chat answers
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Stripe — TEST MODE ONLY (sk_test_… / price_… from test mode). Live keys are refused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Bot shown in the landing-page live demo and /widget-demo (created by `npm run seed`)
NEXT_PUBLIC_DEMO_BOT_ID=6a1d2c3e-4f50-4a7b-9c8d-0e1f2a3b4c5d

# Demo mode (optional): pin the in-memory seed's reference time so numbers stay
# identical across restarts, e.g. 2026-11-03T12:00:00+05:30. Empty = server start time.
DEMO_SEED_NOW=

# Seed script (optional): demo login created by `npm run seed`
SEED_DEMO_EMAIL=demo@askdock.app
SEED_DEMO_PASSWORD=

# Screenshot script (optional, live mode only)
SCREENSHOT_BASE_URL=http://localhost:3000
SCREENSHOT_EMAIL=
SCREENSHOT_PASSWORD=
