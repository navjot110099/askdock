# ---------------------------------------------------------------------------
# AskDock environment
# Copy to .env.local and fill in what you need. Every variable is optional:
# with all of them empty the app runs the in-memory demo workspace (seeded
# Juniper Dental bot, no accounts needed). Never commit real keys.
# ---------------------------------------------------------------------------

# Public URL of this app (auth redirects, Stripe return URLs, embed snippet).
# Empty = the Vercel production domain, or http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=

# Supabase — Project settings → API. Leave empty for demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for widget traffic, ingestion and Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — embeddings (pgvector) and chat answers. Empty = extractive answers.
OPENAI_API_KEY=
# Empty = gpt-5.4-mini
OPENAI_CHAT_MODEL=
# Empty = text-embedding-3-small (1536 dimensions, matches the vector column)
OPENAI_EMBEDDING_MODEL=

# Stripe — TEST MODE ONLY (sk_test_… / price_… from test mode). Live keys are refused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Bot shown in the landing-page live demo and /widget-demo.
# Empty = the seeded Juni bot (the id `npm run seed` prints).
NEXT_PUBLIC_DEMO_BOT_ID=

# Demo mode: pin the in-memory seed's reference time so numbers stay identical
# across restarts, e.g. 2026-11-03T12:00:00+05:30. Empty = server start time.
DEMO_SEED_NOW=

# Seed script: demo login created by `npm run seed`.
# Empty email = demo@askdock.app; empty password = a generated one, printed once.
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=

# Screenshot script. Empty base URL = http://localhost:3000; the login is only
# needed in live mode.
SCREENSHOT_BASE_URL=
SCREENSHOT_EMAIL=
SCREENSHOT_PASSWORD=
